{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Edit(.env)",
      "Read(.env)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
