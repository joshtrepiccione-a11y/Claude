# Copy to .env.local and fill in real values. Never commit real secrets.

# Public URL of the deployed site (no trailing slash). Used for canonical URLs, sitemap, structured data, and .ics links.
SITE_URL=

# Timezone used to interpret event times entered in the admin area and to display them.
SITE_TIMEZONE=America/New_York

# Postgres connection string. On Vercel, attach a database under Storage and this is set for you
# (Vercel also sets POSTGRES_URL, which the app falls back to). Locally, point it at a database
# of your own, or at the same hosted database using the connection string from the Vercel dashboard.
DATABASE_URL=

# TLS behaviour for the database connection. Leave blank for the default: verified TLS for remote
# hosts, plain TCP for localhost. Set to `no-verify` only if your provider uses a self-signed
# certificate, or `disable` to turn TLS off entirely.
DATABASE_SSL=

# Admin sign-in. Generate the hash with: npm run hash-password -- "your password here"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Long random string (32+ characters) used to sign admin session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Optional email notifications for new inquiries (SMTP). Leave blank to keep inquiries in the admin queue only.
NOTIFY_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
