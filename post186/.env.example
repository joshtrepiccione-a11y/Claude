# Copy this file to ".env.local" for local development.
# On the live site, enter these in your host's "Environment Variables" settings instead.

# The public address of the site (no trailing slash).
SITE_URL=https://www.example.org

# First sign-in. Used once to create the first officer account; after that,
# passwords are managed in Admin > Account. Use at least 10 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Database. Leave both blank to use a file on this computer (./data/post186.db).
# On Vercel or Netlify, use a free Turso database: https://turso.tech
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Email notifications (optional). Without these, hall requests and messages
# still appear in the admin area — they just are not emailed.
# Free account: https://resend.com
RESEND_API_KEY=
EMAIL_FROM="American Legion Post 186 <notices@example.org>"
