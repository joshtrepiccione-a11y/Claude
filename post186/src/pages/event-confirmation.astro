---
import Layout from "../layouts/Layout.astro";
---

<Layout title="You're All Set">
  <section class="section">
    <div class="container" style="max-width:640px">
      <div class="panel center">
        <p class="eyebrow">You're all set</p>
        <h1 style="font-size:2.2rem">Thank you — see you at the post!</h1>
        <p class="muted">Your order is complete. A confirmation email with your tickets and event details is on its way.</p>
        <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:24px">
          <a href="/events" class="btn btn--navy">More events</a>
          <a href="/" class="btn btn--outline">Back to home</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
