---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Message Received">
  <section class="section">
    <div class="container" style="max-width:640px">
      <div class="panel center">
        <p class="eyebrow">Message received</p>
        <h1 style="font-size:2.2rem">Thank you for reaching out.</h1>
        <p class="muted">A member of Post 186 will be in touch soon. If you need immediate support, the Veterans Crisis Line is available 24/7 — call 988 and press 1.</p>
        <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:24px">
          <a href="/" class="btn btn--outline">Back to home</a>
          <a href="/events" class="btn btn--navy">See upcoming events</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
